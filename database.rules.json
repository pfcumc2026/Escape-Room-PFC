{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true",
        ".validate": "newData.hasChildren(['state', 'lastChanged'])",
        "state": {
          ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
        },
        "lastChanged": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
