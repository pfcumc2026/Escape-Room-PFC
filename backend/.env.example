# Copie para .env e preencha. Nunca versione o .env real.

NODE_ENV=development
PORT=3000

# Origens do front-end autorizadas no CORS, separadas por vírgula.
# A primeira é usada nos links enviados por e-mail.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=escape_py

# Segredo do JWT (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Chave AES-256 que protege os segredos TOTP (32 bytes em base64). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Envio de e-mails pela API HTTP do Brevo (o plano gratuito do Render bloqueia SMTP)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Escape.py

# Login com Google (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Migração das contas antigas do Firebase (deixe vazio para desligar)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
